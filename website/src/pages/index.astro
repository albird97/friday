---
import DayStory from "../components/DayStory.astro";
import Faq from "../components/Faq.astro";
import FeaturePicker from "../components/FeaturePicker.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Limits from "../components/Limits.astro";
import Nav from "../components/Nav.astro";
import Sky from "../components/Sky.astro";
import Ticker from "../components/Ticker.astro";
import Base from "../layouts/Base.astro";
import { site } from "../lib/content";
import "../styles/chat.css";
import "../styles/sections.css";
---
<Base title={site.title} description={site.description}>
  <Sky />
  <Nav />
  <main>
    <Hero />
    <Ticker />
    <DayStory />
    <div class="night">
      <FeaturePicker />
      <HowItWorks />
      <Limits />
      <Faq />
    </div>
    <FinalCta />
  </main>
  <Footer />
</Base>
