---
import type { Demo } from "../lib/content";
import BubbleItem from "./Bubble.astro";

interface Props {
  demo: Demo;
  time?: string;
}
const { demo, time = demo.story?.time ?? "20.45" } = Astro.props;
---
<div class="chat" role="group" aria-label={`Contoh chat di ${demo.chat}`}>
  <div class="chat__header">
    <span class="chat__avatar" aria-hidden="true">{demo.chat.charAt(0)}</span>
    <span class="chat__who"><strong>{demo.chat}</strong><small>{demo.subtitle ?? "online"}</small></span>
  </div>
  <div class="chat__viewport">
    <ol class="chat__list">
      {demo.thread.map((bubble) => <BubbleItem bubble={bubble} time={time} />)}
    </ol>
    <div class="chat__typing" aria-hidden="true"><span></span><span></span><span></span></div>
  </div>
  <div class="chat__input" aria-hidden="true">
    <span class="chat__field"><span class="chat__placeholder">Ketik pesan</span><span class="chat__draft"></span></span>
    <span class="chat__send">
      <svg class="chat__mic" viewBox="0 0 24 24" width="18" height="18"><path d="M12 15a3.5 3.5 0 0 0 3.5-3.5v-5a3.5 3.5 0 0 0-7 0v5A3.5 3.5 0 0 0 12 15Zm6-3.5a6 6 0 0 1-12 0M12 17.5V21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <svg class="chat__arrow" viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h13M12.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </div>
</div>
