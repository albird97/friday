---
interface Props {
  time?: string;
  class?: string;
}
const { time = "07.30", class: className = "" } = Astro.props;
---
<div class:list={["phone", className]}>
  <div class="phone__display">
    <div class="phone__status" aria-hidden="true">
      <span class="phone__clock">{time}</span>
      <svg viewBox="0 0 42 12" width="38" height="11">
        <path d="M1 8.5h2.2V11H1zM5 6h2.2v5H5zM9 3.5h2.2V11H9zM13 1h2.2v10H13z" fill="currentColor" />
        <rect x="21.5" y="1.5" width="17" height="9" rx="2.5" fill="none" stroke="currentColor" stroke-opacity="0.5" />
        <rect x="23" y="3" width="12" height="6" rx="1.2" fill="currentColor" />
        <rect x="39.5" y="4.2" width="1.5" height="3.6" rx="0.7" fill="currentColor" fill-opacity="0.5" />
      </svg>
    </div>
    <div class="phone__screen"><slot /></div>
  </div>
</div>
