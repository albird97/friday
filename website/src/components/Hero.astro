---
import { ctaUrl, features, site } from "../lib/content";
import Chat from "./Chat.astro";
import Phone from "./Phone.astro";

// One conversation that keeps going, so the phone is never empty. Bubbles with their own time happen later in the day.
const thread = ["friday-01", "friday-02", "friday-03"]
  .flatMap((id) => features.find((feature) => feature.id === id)!.demo.thread)
  .filter((bubble) => !bubble.time);
---
<section class="hero">
  <div class="hero__copy">
    <h1>{site.hero.lines.map((line) => <span class="line"><span>{line}</span></span>)}</h1>
    <p class="hero__sub">{site.hero.sub}</p>
    <div class="hero__actions">
      <a class="button" href={ctaUrl} rel="noopener">Minta akses</a>
      <a class="button button--quiet" href="#sehari">Lihat contohnya</a>
    </div>
    <p class="hero__note">{site.hero.note}</p>
  </div>
  <div class="hero__stage">
    <Phone class="hero__phone" time="07.30">
      <Chat demo={{ chat: "Friday", thread }} time="07.30" shown={2} />
    </Phone>
  </div>
</section>
