# ── Required ──────────────────────────────────────────────────────────────
# Claude API key from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Who can chat with Friday privately: Name=number (country code, no +), comma-separated.
# The FIRST person is the admin and can add/remove people from WhatsApp with /add and /remove.
ALLOWED_CONTACTS=Albert=6281234567890,Wife=6289876543210

# ── Images (optional) ─────────────────────────────────────────────────────
# "cloudflare" = free (Workers AI free plan, ~90 images/day). "gemini" = paid per image.
IMAGE_PROVIDER=cloudflare
# Cloudflare dashboard → Workers AI → "Use REST API": copy the Account ID and create an API token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Only used when IMAGE_PROVIDER=gemini (no free tier for images):
GEMINI_API_KEY=

# ── Errands with people outside the contacts (optional) ───────────────────
# Numbers that may ask Friday to message a restaurant, shop… and handle the replies (private chats only).
# ERRAND_USERS=6281234567890,6289876543210
# ERRAND_DAILY_LIMIT=10               # new errands per day; messaging strangers a lot gets numbers flagged

# ── onehub business back office (optional) ────────────────────────────────
# Numbers that may use onehub through Friday, in private chats only (comma-separated).
# ONEHUB_USERS=6281234567890,6289876543210
# Read access: a PostgreSQL role that can only SELECT (never the app's own database user).
# ONEHUB_DATABASE_URL=postgres://friday_ro:PASSWORD@127.0.0.1:5432/onehub
# Actions: onehub's internal Friday API. Every action is previewed and confirmed with a code first.
# ONEHUB_API_URL=https://example.com/internal/friday
# ONEHUB_API_TOKEN=

# ── Optional tuning ───────────────────────────────────────────────────────
# FRIDAY_MODEL=claude-opus-5-5        # or claude-sonnet-5-5 (cheaper), claude-haiku-5-5 (cheapest)
# FRIDAY_EFFORT=medium                # low | medium | high — how hard Claude thinks
# BOT_NAME=Friday
# TIMEZONE=Asia/Jakarta
# GROUP_ACCESS=everyone               # or "contacts": in groups, only known contacts can use Friday
# DAILY_MESSAGE_LIMIT=50              # per person per day (admin exempt), 0 = unlimited
# PAIRING_NUMBER=                     # bot's number: link with a code instead of a QR scan
# SESSION_IDLE_HOURS=6                # start a fresh conversation after this much silence
# DATA_DIR=./data
