# ── Required ──────────────────────────────────────────────────────────────
# Claude API key from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Who can chat with Friday privately: Name=number (country code, no +), comma-separated.
# The FIRST person is the admin and can add/remove people from WhatsApp with /add and /remove.
ALLOWED_CONTACTS=Albert=6281234567890,Wife=6289876543210

# ── Images (optional) ─────────────────────────────────────────────────────
# "cloudflare" = free (Workers AI free plan, ~90 images/day). "gemini" = paid per image.
IMAGE_PROVIDER=cloudflare
# Cloudflare dashboard → Workers AI → "Use REST API": copy the Account ID and create an API token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Only used when IMAGE_PROVIDER=gemini (no free tier for images):
GEMINI_API_KEY=

# ── Errands with people outside the contacts (optional) ───────────────────
# Numbers that may ask Friday to message a restaurant, shop… and handle the replies (private chats only).
# ERRAND_USERS=6281234567890,6289876543210
# ERRAND_DAILY_LIMIT=10               # new errands per day; messaging strangers a lot gets numbers flagged
# Numbers that may pick the Claude model of their own private chat with /switch (the admin always can).
# SWITCH_USERS=6281234567890

# ── onehub business back office (optional) ────────────────────────────────
# Numbers that may use onehub through Friday, in private chats only (comma-separated).
# ONEHUB_USERS=6281234567890,6289876543210
# Groups where those people may also ask for an order's shipping label (only that; everyone in the group sees it).
# ONEHUB_RESI_GROUPS=120363000000000000@g.us
# Read access: a PostgreSQL role that can only SELECT (never the app's own database user).
# ONEHUB_DATABASE_URL=postgres://friday_ro:PASSWORD@127.0.0.1:5432/onehub
# Actions: onehub's internal Friday API. Every action is previewed and confirmed with a code first.
# ONEHUB_API_URL=https://example.com/internal/friday
# ONEHUB_API_TOKEN=

# ── Smart Life devices (optional) ─────────────────────────────────────────
# A cloud project at platform.tuya.com with the Smart Life app account linked (see README → Smart Life).
# TUYA_ACCESS_ID=
# TUYA_ACCESS_SECRET=
# TUYA_UID=                           # Devices → Link App Account → the linked account's UID
# TUYA_REGION=                        # the project's data center: cn | us | us-e | eu | eu-w | in | sg
# TUYA_USERS=6289876543210            # who else may control the devices from their private chat (the admin always can)

# ── Optional tuning ───────────────────────────────────────────────────────
# PUBLIC_URL=https://fridayai.my.id  # needed for Google sign-in; its pages listen on WEB_PORT behind nginx
# WEB_PORT=3210
# The dashboard at PUBLIC_URL/admin. Set both with `sudo scripts/linux-service.sh admin`, which stores only a scrypt
# hash of the password (never the password itself). Either one empty = no dashboard.
# ADMIN_USER=
# ADMIN_PASSWORD_HASH=
# BACKUP_DIR=/opt/friday/backups      # where the nightly backups go, so the dashboard can tell when the last one ran
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_KEY=                   # openssl rand -hex 32; encrypts each person's Google and Spotify tokens and Hevy API keys
# SPOTIFY_CLIENT_ID=                  # from developer.spotify.com; /spotify links each person's own account
# SPOTIFY_CLIENT_SECRET=
# SHOPEE_PARTNER_ID=                  # Friday's own app at open.shopee.com (not onehub's); /shopee links each person's shop
# SHOPEE_PARTNER_KEY=
# SHOPEE_API_URL=https://partner.shopeemobile.com  # sandbox: https://openplatform.sandbox.test-stable.shopee.sg
#                                     # (Hevy needs only GOOGLE_TOKEN_KEY: people link their own account with /hevy)
# USAGE_ALERT_DAILY_TOTAL=20            # tell the admin when today's estimated Claude spend passes this (USD); 0 = off
# USAGE_ALERT_DAILY_PERSON=5            # …or when one person's does. Alerts only inform; nobody is blocked.
# USD_TO_IDR=16500                      # exchange rate for the rupiah estimate in /status
# FRIDAY_MODEL=claude-opus-5-5        # the starting model; change it later with /switch opus|sonnet|haiku
# FRIDAY_EFFORT=medium                # low | medium | high — how hard Claude thinks
# BOT_NAME=Friday
# TIMEZONE=Asia/Jakarta
# GROUP_ACCESS=everyone               # or "contacts": in groups, only known contacts can use Friday
# DAILY_MESSAGE_LIMIT=50              # per person per day (admin exempt), 0 = unlimited
# ACCESS_REQUEST_DAILY_LIMIT=20       # access requests from the website answered per day
# DEPLOY_HOST=                        # user@host for scripts/deploy-website.sh, only needed on your own machine
# PAIRING_NUMBER=                     # bot's number: link with a code instead of a QR scan
# SESSION_IDLE_HOURS=1                # start a fresh conversation after this much silence (a short recap carries over)
# SESSION_MAX_TOKENS=40000            # …or once it grows past this many tokens
# DATA_DIR=./data
